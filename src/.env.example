# Database (SurrealDB)
# scripts/local-db.sh prints these values for a local instance
KG_DB_URL=ws://127.0.0.1:8000
KG_DB_USER=root
KG_DB_PASS=root
KG_DB_NS=kg
KG_DB_NAME=local
# Random, at least 32 characters. Authenticates the server's SurrealDB sign-in
KG_JWT_SECRET=replace-with-at-least-32-random-characters

# Auth mode. komplyt (default) verifies Komplyt-issued JWTs, as hosted does. local turns token
# checking off: every request is one fixed user in one fixed tenant, for self-hosting without an
# identity provider. The server warns on every start; securing the container is your job.
# local cannot be combined with KOMPLYT_JWKS_URL or KOMPLYT_ISSUER: comment those two lines out below.
# KG_AUTH_MODE=local
# KG_LOCAL_SUB=local
# KG_LOCAL_TENANT=local

# OIDC issuer whose access tokens the server accepts (tokens need a tenantId claim)
# See docs/self-hosting.md
KOMPLYT_JWKS_URL=https://auth.example.com/.well-known/jwks.json
KOMPLYT_ISSUER=https://auth.example.com
KOMPLYT_AUDIENCE=kg-server

# Embedding provider (cohere | ollama | fixture). One per install: the model must
# output 1024 dimensions (checked at boot; ollama is probed with one embedding,
# up to 5 attempts of at most 10s, 1/2/3/4s apart: at most 60s, then the
# server exits). Switching provider on an existing database requires
# re-embedding (bin/reembed.ts): vectors from different models are incompatible.
EMBEDDING_PROVIDER=cohere
EMBEDDING_API_KEY=your-cohere-api-key
# COHERE_API_KEY is still accepted in place of EMBEDDING_API_KEY for cohere.
# Optional for cohere: EMBEDDING_BASE_URL (default https://api.cohere.com/v1; requests go to <base>/embed).

# Ollama (alternative to Cohere, for local embeddings; no API key).
# OLLAMA_URL / OLLAMA_MODEL are still accepted as aliases; the generic names win.
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL=bge-m3

# Server
KG_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
LISTEN_ADDR=0.0.0.0:3000
# Local auth mode (KG_AUTH_MODE=local): LISTEN_ADDR defaults to 127.0.0.1:3000 when unset, and requests
# need a loopback Host, a JSON Content-Type and no foreign Origin. Extra Host values (reverse proxy):
# KG_LOCAL_ALLOWED_HOSTS=kg.internal:3000

# Container purge job (CAP-1): Bearer secret for /admin/purge.
# High-entropy, min 32 chars. Absent = purge endpoint disabled (404s).
PURGE_JOB_SECRET=

# kg_auth_session pruning: every scoped request signs in and leaves a row.
# Retention must exceed the longest-lived scoped connection (default: a day).
# KG_SESSION_PRUNE=true
# KG_SESSION_RETENTION_HOURS=24
# KG_SESSION_PRUNE_INTERVAL_MINUTES=60

# Bearer token for /metrics and /pool-metrics (min 16 chars). Absent = open.
# METRICS_TOKEN=

# Optional
# KG_EMBED_FIXTURES is deprecated - use EMBEDDING_PROVIDER=fixture instead
LOG_LEVEL=info
# Better Stack source token; when unset, logs go to stdout only
LOGTAIL_TOKEN=
