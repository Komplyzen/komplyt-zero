# 1Password references for bench.sh when BENCH_ENV=op. No secrets here.
# One NAME=op://vault/item/field per line. Vars already set in the environment win.
COHERE_API_KEY=op://<vault>/<cohere-item>/<field>
ANTHROPIC_API_KEY=op://<vault>/<anthropic-item>/<field>
OPENAI_API_KEY=op://<vault>/<openai-item>/<field>
