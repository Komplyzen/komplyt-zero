-- Migration 000: schema baseline
--
-- The schema of the hosted production database on 2026-10-07, after the
-- pre-release migrations 000_bootstrap .. 033_signin_secret_enforce (that
-- history lives on in the hosted platform). Generated with
-- `scripts/schema-info.py --apply` from production's INFO FOR DB / TABLE:
-- schema only, no records, no JWT key on DEFINE ACCESS (SurrealDB generates
-- one per database).
--
-- It includes definitions the current server no longer uses (the old OAuth
-- and API-key tables, user/org/project_member, the kg_api access, SurrealKit's
-- __entity/__rollout, project.created_by/org). They are part of production
-- today; removing them is a separate, later migration.
--
-- For a FRESH database only. Tables, indexes and access methods are plain
-- DEFINE and fail on a database that already has them; fields are DEFINE
-- FIELD OVERWRITE because an array field implicitly creates its `.*` element
-- field, which the explicit definition (e.g. the signin_sha256s.* ASSERT)
-- must replace. Hosted databases are recorded as having this baseline by the
-- migration runner after their schema is checked against it, never re-run.
--
-- Never edit this file: every schema change is the next numbered migration.
-- scripts/schema-diff.sh compares two databases' schemas.

DEFINE TABLE __entity TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD OVERWRITE key ON __entity TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE ns ON __entity TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE updated_at ON __entity TYPE datetime DEFAULT time::now() PERMISSIONS FULL;
DEFINE FIELD OVERWRITE val ON __entity TYPE any PERMISSIONS FULL;
DEFINE INDEX by_ns_key ON __entity FIELDS ns, key UNIQUE;
DEFINE TABLE __rollout TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD OVERWRITE completed_at ON __rollout TYPE none | datetime PERMISSIONS FULL;
DEFINE FIELD OVERWRITE id ON __rollout TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE last_error ON __rollout TYPE none | string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE manifest_checksum ON __rollout TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE manifest_path ON __rollout TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE name ON __rollout TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE source_entities ON __rollout TYPE any PERMISSIONS FULL;
DEFINE FIELD OVERWRITE source_schema_hash ON __rollout TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE started_at ON __rollout TYPE datetime DEFAULT time::now() PERMISSIONS FULL;
DEFINE FIELD OVERWRITE status ON __rollout TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE steps ON __rollout TYPE any DEFAULT [] PERMISSIONS FULL;
DEFINE FIELD OVERWRITE target_entities ON __rollout TYPE any PERMISSIONS FULL;
DEFINE FIELD OVERWRITE target_schema_hash ON __rollout TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE updated_at ON __rollout TYPE datetime DEFAULT time::now() PERMISSIONS FULL;
DEFINE INDEX by_rollout_id ON __rollout FIELDS id UNIQUE;
DEFINE TABLE _migrations TYPE NORMAL SCHEMAFULL PERMISSIONS FULL;
DEFINE FIELD OVERWRITE applied_at ON _migrations TYPE datetime DEFAULT time::now() PERMISSIONS FULL;
DEFINE FIELD OVERWRITE applied_by ON _migrations TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE checksum ON _migrations TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE filename ON _migrations TYPE string PERMISSIONS FULL;
DEFINE INDEX migrations_filename ON _migrations FIELDS filename UNIQUE;
DEFINE TABLE api_key TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD OVERWRITE allowed_users ON api_key TYPE array<record<user>> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE allowed_users.* ON api_key TYPE record<user> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE created_at ON api_key TYPE datetime DEFAULT time::now() PERMISSIONS FULL;
DEFINE FIELD OVERWRITE expires_at ON api_key TYPE none | datetime PERMISSIONS FULL;
DEFINE FIELD OVERWRITE key_argon2 ON api_key TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE key_hash ON api_key TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE last_used ON api_key TYPE none | datetime PERMISSIONS FULL;
DEFINE FIELD OVERWRITE name ON api_key TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE org ON api_key TYPE record<org> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE scopes ON api_key TYPE array<string> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE scopes.* ON api_key TYPE string PERMISSIONS FULL;
DEFINE INDEX api_key_hash ON api_key FIELDS key_hash UNIQUE;
DEFINE TABLE audit_log TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD OVERWRITE action ON audit_log TYPE string ASSERT $value INSIDE ['container_purge', 'admin_soft_delete'] PERMISSIONS FULL;
DEFINE FIELD OVERWRITE actor ON audit_log TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE container_id ON audit_log TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE edge_count ON audit_log TYPE none | int PERMISSIONS FULL;
DEFINE FIELD OVERWRITE node_count ON audit_log TYPE none | int PERMISSIONS FULL;
DEFINE FIELD OVERWRITE reason ON audit_log TYPE none | string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE tenant_id ON audit_log TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE timestamp ON audit_log TYPE datetime DEFAULT time::now() PERMISSIONS FULL;
DEFINE INDEX audit_log_action ON audit_log FIELDS action;
DEFINE INDEX audit_log_tenant ON audit_log FIELDS tenant_id;
DEFINE INDEX audit_log_timestamp ON audit_log FIELDS timestamp;
DEFINE TABLE author TYPE NORMAL SCHEMAFULL PERMISSIONS FOR select, create WHERE tenant = type::record('tenant', $auth.tenantId), FOR update, delete NONE;
DEFINE FIELD OVERWRITE created_at ON author TYPE datetime DEFAULT time::now() PERMISSIONS FULL;
DEFINE FIELD OVERWRITE name ON author TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE tenant ON author TYPE record<tenant> PERMISSIONS FULL;
DEFINE INDEX author_name ON author FIELDS name UNIQUE;
DEFINE INDEX author_tenant ON author FIELDS tenant;
DEFINE TABLE container TYPE NORMAL SCHEMAFULL PERMISSIONS FOR select, create, update WHERE tenant = type::record('tenant', $auth.tenantId), FOR delete NONE;
DEFINE FIELD OVERWRITE created_at ON container TYPE datetime DEFAULT time::now() PERMISSIONS FULL;
DEFINE FIELD OVERWRITE deleted_at ON container TYPE none | datetime DEFAULT NONE PERMISSIONS FULL;
DEFINE FIELD OVERWRITE first_deleted_at ON container TYPE none | datetime DEFAULT NONE PERMISSIONS FULL;
DEFINE FIELD OVERWRITE granted_principals ON container TYPE array<record<principal>> DEFAULT [] PERMISSIONS FULL;
DEFINE FIELD OVERWRITE granted_principals.* ON container TYPE record<principal> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE name ON container TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE owner ON container TYPE record<principal> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE tenant ON container TYPE record<tenant> PERMISSIONS FULL;
DEFINE INDEX container_deleted_at ON container FIELDS deleted_at;
DEFINE INDEX container_owner ON container FIELDS owner;
DEFINE INDEX container_tenant ON container FIELDS tenant;
DEFINE INDEX container_tenant_name ON container FIELDS tenant, name UNIQUE;
DEFINE TABLE decay_event TYPE NORMAL SCHEMAFULL PERMISSIONS FOR select, create WHERE session_id.tenant = type::record('tenant', $auth.tenantId), FOR update, delete NONE;
DEFINE FIELD OVERWRITE complexity ON decay_event TYPE none | float PERMISSIONS FULL;
DEFINE FIELD OVERWRITE created_at ON decay_event TYPE datetime DEFAULT time::now() PERMISSIONS FULL;
DEFINE FIELD OVERWRITE event_type ON decay_event TYPE string ASSERT $value INSIDE ['created', 'session_decay', 'activation', 'manual'] PERMISSIONS FULL;
DEFINE FIELD OVERWRITE factor ON decay_event TYPE none | float PERMISSIONS FULL;
DEFINE FIELD OVERWRITE local_edges ON decay_event TYPE none | int PERMISSIONS FULL;
DEFINE FIELD OVERWRITE local_nodes ON decay_event TYPE none | int PERMISSIONS FULL;
DEFINE FIELD OVERWRITE new_score ON decay_event TYPE float PERMISSIONS FULL;
DEFINE FIELD OVERWRITE node ON decay_event TYPE record<node> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE old_score ON decay_event TYPE float PERMISSIONS FULL;
DEFINE FIELD OVERWRITE reason ON decay_event TYPE none | string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE session_id ON decay_event TYPE record<session> PERMISSIONS FULL;
DEFINE INDEX decay_event_node ON decay_event FIELDS node;
DEFINE INDEX decay_event_session ON decay_event FIELDS session_id;
DEFINE INDEX decay_event_type ON decay_event FIELDS event_type;
DEFINE TABLE edge TYPE RELATION IN node OUT node SCHEMAFULL PERMISSIONS FOR select FULL, FOR create, update WHERE in.tenant = type::record('tenant', $auth.tenantId) AND out.tenant = type::record('tenant', $auth.tenantId), FOR delete NONE;
DEFINE FIELD OVERWRITE created_at ON edge TYPE datetime DEFAULT time::now() PERMISSIONS FULL;
DEFINE FIELD OVERWRITE in ON edge TYPE record<node> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE last_reinforced ON edge TYPE datetime DEFAULT time::now() PERMISSIONS FULL;
DEFINE FIELD OVERWRITE out ON edge TYPE record<node> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE session_reinforced ON edge TYPE none | record<session> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE type ON edge TYPE string ASSERT $value INSIDE ['explicit', 'co_activation'] PERMISSIONS FULL;
DEFINE FIELD OVERWRITE weight ON edge TYPE float DEFAULT 1f PERMISSIONS FULL;
DEFINE INDEX edge_in ON edge FIELDS in;
DEFINE INDEX edge_out ON edge FIELDS out;
DEFINE INDEX edge_session ON edge FIELDS session_reinforced;
DEFINE INDEX edge_type ON edge FIELDS type;
DEFINE TABLE granted TYPE RELATION IN container OUT principal SCHEMAFULL PERMISSIONS FOR select, create, delete WHERE in.tenant = type::record('tenant', $auth.tenantId), FOR update NONE;
DEFINE FIELD OVERWRITE created_at ON granted TYPE datetime DEFAULT time::now() PERMISSIONS FULL;
DEFINE FIELD OVERWRITE in ON granted TYPE record<container> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE out ON granted TYPE record<principal> PERMISSIONS FULL;
DEFINE INDEX granted_in ON granted FIELDS in;
DEFINE INDEX granted_lookup ON granted FIELDS in, out;
DEFINE INDEX granted_out ON granted FIELDS out;
DEFINE TABLE kg_auth_session TYPE NORMAL SCHEMAFULL PERMISSIONS FOR select FULL, FOR create, update, delete NONE;
DEFINE FIELD OVERWRITE principals ON kg_auth_session TYPE array<string> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE principals.* ON kg_auth_session TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE projects ON kg_auth_session TYPE array<string> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE projects.* ON kg_auth_session TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE scope ON kg_auth_session TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE sub ON kg_auth_session TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE tenantId ON kg_auth_session TYPE string PERMISSIONS FULL;
DEFINE TABLE kg_config TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD OVERWRITE signin_sha256s ON kg_config TYPE array<string> DEFAULT [] PERMISSIONS FULL;
DEFINE FIELD OVERWRITE signin_sha256s.* ON kg_config TYPE string ASSERT string::len($value) = 64 AND string::is_hexadecimal($value) AND $value = string::lowercase($value) AND $value != 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855' PERMISSIONS FULL;
DEFINE TABLE node TYPE NORMAL SCHEMAFULL PERMISSIONS FOR select, create, update WHERE tenant = type::record('tenant', $auth.tenantId) AND (container = NONE OR array::any($auth.principals, |$p: any| { LET $parts = string::split($p, ':'); RETURN container.granted_principals CONTAINS type::record($parts[0], $parts[1]); })), FOR delete NONE;
DEFINE FIELD OVERWRITE author ON node TYPE none | record<author> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE container ON node TYPE none | record<container> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE content ON node TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE created_at ON node TYPE datetime DEFAULT time::now() PERMISSIONS FULL;
DEFINE FIELD OVERWRITE decay_score ON node TYPE float DEFAULT 1f PERMISSIONS FULL;
DEFINE FIELD OVERWRITE embedding ON node TYPE none | array<float> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE embedding.* ON node TYPE float PERMISSIONS FULL;
DEFINE FIELD OVERWRITE embedding_model ON node TYPE none | string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE last_activated ON node TYPE datetime DEFAULT time::now() PERMISSIONS FULL;
DEFINE FIELD OVERWRITE poincare_embedding ON node TYPE none | array<float> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE poincare_embedding.* ON node TYPE float PERMISSIONS FULL;
DEFINE FIELD OVERWRITE poincare_embedding_pending ON node TYPE none | array<float> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE poincare_embedding_pending.* ON node TYPE float PERMISSIONS FULL;
DEFINE FIELD OVERWRITE poincare_magnitude ON node TYPE none | float PERMISSIONS FULL;
DEFINE FIELD OVERWRITE poincare_trained_at ON node TYPE none | datetime PERMISSIONS FULL;
DEFINE FIELD OVERWRITE project ON node TYPE none | record<project> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE session_activated ON node TYPE record<session> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE session_created ON node TYPE record<session> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE source ON node TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE status ON node TYPE none | string ASSERT $value INSIDE [NONE, 'open', 'resolved', 'blocked', 'done'] PERMISSIONS FULL;
DEFINE FIELD OVERWRITE tags ON node TYPE none | array<string> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE tags.* ON node TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE tenant ON node TYPE none | record<tenant> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE type ON node TYPE string ASSERT $value INSIDE ['observation', 'decision', 'argument', 'todo', 'problem', 'mitigation', 'workaround', 'approach'] PERMISSIONS FULL;
DEFINE INDEX node_author ON node FIELDS author;
DEFINE INDEX node_container ON node FIELDS container;
DEFINE INDEX node_decay ON node FIELDS decay_score;
DEFINE INDEX node_embedding ON node FIELDS embedding HNSW DIMENSION 1024 DIST COSINE TYPE F32 EFC 150 M 12 M0 24 LM 0.40242960438184466f;
DEFINE INDEX node_project ON node FIELDS project;
DEFINE INDEX node_session_activated ON node FIELDS session_activated;
DEFINE INDEX node_session_created ON node FIELDS session_created;
DEFINE INDEX node_status ON node FIELDS status;
DEFINE INDEX node_tenant ON node FIELDS tenant;
DEFINE INDEX node_type ON node FIELDS type;
DEFINE TABLE oauth_client TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD OVERWRITE client_name ON oauth_client TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE created_at ON oauth_client TYPE datetime DEFAULT time::now() PERMISSIONS FULL;
DEFINE FIELD OVERWRITE redirect_uris ON oauth_client TYPE array<string> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE redirect_uris.* ON oauth_client TYPE string PERMISSIONS FULL;
DEFINE TABLE oauth_code TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD OVERWRITE api_key ON oauth_code TYPE record<api_key> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE client ON oauth_code TYPE record<oauth_client> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE code_hash ON oauth_code TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE created_at ON oauth_code TYPE datetime DEFAULT time::now() PERMISSIONS FULL;
DEFINE FIELD OVERWRITE expires_at ON oauth_code TYPE datetime PERMISSIONS FULL;
DEFINE FIELD OVERWRITE org ON oauth_code TYPE record<org> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE pkce_challenge ON oauth_code TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE redirect_uri ON oauth_code TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE user ON oauth_code TYPE record<user> PERMISSIONS FULL;
DEFINE INDEX oauth_code_hash ON oauth_code FIELDS code_hash UNIQUE;
DEFINE TABLE oauth_token TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD OVERWRITE api_key ON oauth_token TYPE record<api_key> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE client ON oauth_token TYPE record<oauth_client> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE consumed ON oauth_token TYPE bool DEFAULT false PERMISSIONS FULL;
DEFINE FIELD OVERWRITE consumed_at ON oauth_token TYPE none | datetime PERMISSIONS FULL;
DEFINE FIELD OVERWRITE created_at ON oauth_token TYPE datetime DEFAULT time::now() PERMISSIONS FULL;
DEFINE FIELD OVERWRITE expires_at ON oauth_token TYPE datetime PERMISSIONS FULL;
DEFINE FIELD OVERWRITE family ON oauth_token TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE grant_expires_at ON oauth_token TYPE datetime PERMISSIONS FULL;
DEFINE FIELD OVERWRITE org ON oauth_token TYPE record<org> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE refresh_hash ON oauth_token TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE user ON oauth_token TYPE record<user> PERMISSIONS FULL;
DEFINE INDEX oauth_refresh_hash ON oauth_token FIELDS refresh_hash UNIQUE;
DEFINE INDEX oauth_token_family ON oauth_token FIELDS family;
DEFINE TABLE org TYPE NORMAL SCHEMAFULL PERMISSIONS FOR select WHERE id = type::record('org', $token.org), FOR create, update, delete NONE;
DEFINE FIELD OVERWRITE created_at ON org TYPE datetime DEFAULT time::now() PERMISSIONS FULL;
DEFINE FIELD OVERWRITE name ON org TYPE string PERMISSIONS FULL;
DEFINE INDEX org_name ON org FIELDS name UNIQUE;
DEFINE TABLE principal TYPE NORMAL SCHEMAFULL PERMISSIONS FOR select WHERE id INSIDE $auth.principals OR id INSIDE (SELECT out FROM granted WHERE in.tenant = type::record('tenant', $auth.tenantId)), FOR create, update, delete NONE;
DEFINE FIELD OVERWRITE created_at ON principal TYPE datetime DEFAULT time::now() PERMISSIONS FULL;
DEFINE FIELD OVERWRITE ref_id ON principal TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE type ON principal TYPE string ASSERT $value INSIDE ['User', 'Tenant', 'Project'] PERMISSIONS FULL;
DEFINE INDEX principal_lookup ON principal FIELDS type, ref_id UNIQUE;
DEFINE TABLE project TYPE NORMAL SCHEMAFULL PERMISSIONS FOR select, create WHERE tenant = type::record('tenant', $auth.tenantId), FOR update, delete NONE;
DEFINE FIELD OVERWRITE created_at ON project TYPE datetime DEFAULT time::now() PERMISSIONS FULL;
DEFINE FIELD OVERWRITE created_by ON project TYPE none | record<user> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE name ON project TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE org ON project TYPE none | record<org> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE tenant ON project TYPE record<tenant> PERMISSIONS FULL;
DEFINE INDEX project_name_tenant ON project FIELDS name, tenant UNIQUE;
DEFINE INDEX project_tenant ON project FIELDS tenant;
DEFINE TABLE project_member TYPE NORMAL SCHEMAFULL PERMISSIONS FOR select WHERE user = type::record('user', $token.user), FOR create WHERE user = type::record('user', $token.user) AND project.created_by = type::record('user', $token.user), FOR update, delete NONE;
DEFINE FIELD OVERWRITE added_at ON project_member TYPE datetime DEFAULT time::now() PERMISSIONS FULL;
DEFINE FIELD OVERWRITE project ON project_member TYPE record<project> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE role ON project_member TYPE string ASSERT $value INSIDE ['viewer', 'editor', 'owner'] PERMISSIONS FULL;
DEFINE FIELD OVERWRITE user ON project_member TYPE record<user> PERMISSIONS FULL;
DEFINE INDEX project_member_project ON project_member FIELDS project;
DEFINE INDEX project_member_unique ON project_member FIELDS user, project UNIQUE;
DEFINE INDEX project_member_user ON project_member FIELDS user;
DEFINE TABLE session TYPE NORMAL SCHEMAFULL PERMISSIONS FOR select, create, update WHERE tenant = type::record('tenant', $auth.tenantId), FOR delete NONE;
DEFINE FIELD OVERWRITE ended_at ON session TYPE none | datetime PERMISSIONS FULL;
DEFINE FIELD OVERWRITE notes ON session TYPE none | string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE project ON session TYPE none | record<project> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE session_num ON session TYPE none | int PERMISSIONS FULL;
DEFINE FIELD OVERWRITE started_at ON session TYPE datetime DEFAULT time::now() PERMISSIONS FULL;
DEFINE FIELD OVERWRITE tenant ON session TYPE none | record<tenant> PERMISSIONS FULL;
DEFINE INDEX session_num ON session FIELDS session_num;
DEFINE INDEX session_project ON session FIELDS project;
DEFINE INDEX session_started_at ON session FIELDS started_at;
DEFINE INDEX session_tenant ON session FIELDS tenant;
DEFINE TABLE tenant TYPE NORMAL SCHEMAFULL PERMISSIONS FOR select WHERE id = type::record('tenant', $auth.tenantId), FOR create, update, delete NONE;
DEFINE FIELD OVERWRITE created_at ON tenant TYPE datetime DEFAULT time::now() PERMISSIONS FULL;
DEFINE FIELD OVERWRITE name ON tenant TYPE string PERMISSIONS FULL;
DEFINE INDEX tenant_name ON tenant FIELDS name UNIQUE;
DEFINE TABLE training_run TYPE NORMAL SCHEMAFULL PERMISSIONS FOR select WHERE container.tenant = type::record('tenant', $auth.tenantId), FOR create, update, delete NONE;
DEFINE FIELD OVERWRITE completed_at ON training_run TYPE none | datetime PERMISSIONS FULL;
DEFINE FIELD OVERWRITE container ON training_run TYPE record<container> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE dimensions ON training_run TYPE int DEFAULT 50 PERMISSIONS FULL;
DEFINE FIELD OVERWRITE duration_seconds ON training_run TYPE none | float PERMISSIONS FULL;
DEFINE FIELD OVERWRITE edge_count ON training_run TYPE int PERMISSIONS FULL;
DEFINE FIELD OVERWRITE epochs ON training_run TYPE none | int PERMISSIONS FULL;
DEFINE FIELD OVERWRITE error_message ON training_run TYPE none | string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE final_loss ON training_run TYPE none | float PERMISSIONS FULL;
DEFINE FIELD OVERWRITE node_count ON training_run TYPE int PERMISSIONS FULL;
DEFINE FIELD OVERWRITE started_at ON training_run TYPE datetime DEFAULT time::now() PERMISSIONS FULL;
DEFINE FIELD OVERWRITE status ON training_run TYPE string ASSERT $value INSIDE ['running', 'completed', 'failed'] PERMISSIONS FULL;
DEFINE INDEX training_run_container ON training_run FIELDS container;
DEFINE INDEX training_run_status ON training_run FIELDS status;
DEFINE TABLE user TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD OVERWRITE created_at ON user TYPE datetime DEFAULT time::now() PERMISSIONS FULL;
DEFINE FIELD OVERWRITE email ON user TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE org ON user TYPE record<org> PERMISSIONS FULL;
DEFINE INDEX user_email ON user FIELDS email UNIQUE;
DEFINE ACCESS kg_api ON DATABASE TYPE RECORD DURATION FOR TOKEN 1h, FOR SESSION NONE;
DEFINE ACCESS kg_server ON DATABASE TYPE RECORD SIGNIN (IF crypto::sha256($secret ?? '') INSIDE (SELECT VALUE signin_sha256s FROM ONLY kg_config:signin) { CREATE kg_auth_session CONTENT { tenantId: $tenantId, principals: $principals, sub: $sub, scope: $scope, projects: $projects } } ELSE { THROW 'kg_server signin rejected: secret not in kg_config:signin allowlist' }) DURATION FOR TOKEN 1h, FOR SESSION NONE;
